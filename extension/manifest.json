{
  "manifest_version": 3,
  "name": "Insta Follower Review",
  "version": "1.0.0",
  "description": "Fetch followers/following and unfollow accounts directly from Instagram — no copy/paste needed.",
  "permissions": ["storage", "downloads", "scripting", "activeTab"],
  "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
